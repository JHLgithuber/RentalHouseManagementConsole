# RentalHousingManagementConsole (Frontend) .env 예시 파일
# 이 파일을 프로젝트 루트(.sln이 있는 폴더)에 .env로 복사하여 사용하세요.
# 주의: 실 운영 정보는 절대 저장소에 커밋하지 마세요.

# 백엔드 기본 주소
# 예) 원격 서버
BACKEND_BASE_URL=http://hm.jftt.kr/
# 예) 로컬 개발 서버 (Flask)
#BACKEND_BASE_URL=http://127.0.0.1:5000/

# 로컬 파이썬 백엔드를 앱이 자동으로 기동할지 여부
# 기본값은 false (원격 백엔드 사용)
# true 로 설정하면 HM_Backend\run_unsecu.py(없으면 run.py)를 실행합니다.
HM_USE_LOCAL_BACKEND=false

# (선택) 로컬 백엔드를 기동할 때 사용할 파이썬 실행 파일 절대경로
# 지정하지 않으면 저장소 내 가상환경(HM_Backend\myenv_of_HM) 또는 PATH의 python을 시도합니다.
# HM_BACKEND_PYTHON=C:\\Python312\\python.exe
