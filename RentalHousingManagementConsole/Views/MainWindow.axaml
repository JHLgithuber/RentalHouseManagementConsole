<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RentalHousingManagementConsole.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:RentalHousingManagementConsole.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="RentalHousingManagementConsole.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="RentalHousingManagementConsole"
        Width="1200"
        Height="800">
  <!-- Content는 코드에서 동적으로 설정됨 (LoginView 또는 MainView) -->
</Window>
