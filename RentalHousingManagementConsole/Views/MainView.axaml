<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RentalHousingManagementConsole.ViewModels"
             xmlns:converters="clr-namespace:Avalonia.Markup.Xaml.Converters;assembly=Avalonia.Markup.Xaml"
             xmlns:controls="clr-namespace:RentalHousingManagementConsole.Controls"
             xmlns:conv="clr-namespace:RentalHousingManagementConsole.Converters"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="RentalHousingManagementConsole.Views.MainView"
             x:DataType="vm:MainViewModel"><!-- CHANGED: 컨버터 네임스페이스 + AutoUniformGrid 네임스페이스 추가 -->

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <UserControl.Resources>
    <conv:InverseBooleanConverter x:Key="InverseBool" />
    <conv:PageTypeConverter x:Key="PageTypeConverter" />
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Top App Bar -->
    <!-- 테마 색상 설정: Background="{DynamicResource SystemAccentColor}" - 상단바의 배경색 (테마 색상) -->
    <Border Background="{DynamicResource SystemAccentColor}" Padding="12,8" Grid.Row="0"
            IsVisible="{Binding IsFullScreen, Converter={StaticResource InverseBool}}">
      <DockPanel>
        <!-- 햄버거 -->
        <ToggleButton x:Name="HamburgerButton"
                      IsChecked="{Binding IsPaneOpen, Mode=TwoWay}"
                      Width="40" Height="36"
                      VerticalAlignment="Center"
                      ToolTip.Tip="메뉴"
                      DockPanel.Dock="Left">
          <Path Data="M3,6 H21 M3,12 H21 M3,18 H21" Stroke="White" StrokeThickness="2" StrokeLineCap="Round"/>
        </ToggleButton>

        <!-- 대시보드 타이틀 -->
        <TextBlock Text="임대주택 대시보드" FontSize="18" Foreground="White"
                   Margin="12,0,0,0" VerticalAlignment="Center"
                   DockPanel.Dock="Left">
          <TextBlock.IsVisible>
            <Binding Path="CurrentPage" Converter="{StaticResource PageTypeConverter}" ConverterParameter="Dashboard"/>
          </TextBlock.IsVisible>
        </TextBlock>

        <!-- 세대관리 타이틀 -->
        <TextBlock Text="임대주택 세대관리" FontSize="18" Foreground="White"
                   Margin="12,0,0,0" VerticalAlignment="Center"
                   DockPanel.Dock="Left">
          <TextBlock.IsVisible>
            <Binding Path="CurrentPage" Converter="{StaticResource PageTypeConverter}" ConverterParameter="UnitManagement"/>
          </TextBlock.IsVisible>
        </TextBlock>

        <!-- 임대료/미납 타이틀 -->
        <TextBlock Text="임대주택 임대료/미납" FontSize="18" Foreground="White"
                   Margin="12,0,0,0" VerticalAlignment="Center"
                   DockPanel.Dock="Left">
          <TextBlock.IsVisible>
            <Binding Path="CurrentPage" Converter="{StaticResource PageTypeConverter}" ConverterParameter="RentPayment"/>
          </TextBlock.IsVisible>
        </TextBlock>

        <!-- 공과금 납입 관리 타이틀 -->
        <TextBlock Text="임대주택 공과금 납입 관리" FontSize="18" Foreground="White"
                   Margin="12,0,0,0" VerticalAlignment="Center"
                   DockPanel.Dock="Left">
          <TextBlock.IsVisible>
            <Binding Path="CurrentPage" Converter="{StaticResource PageTypeConverter}" ConverterParameter="UtilityBills"/>
          </TextBlock.IsVisible>
        </TextBlock>

        <!-- 통계 타이틀 -->
        <TextBlock Text="임대주택 통계" FontSize="18" Foreground="White"
                   Margin="12,0,0,0" VerticalAlignment="Center"
                   DockPanel.Dock="Left">
          <TextBlock.IsVisible>
            <Binding Path="CurrentPage" Converter="{StaticResource PageTypeConverter}" ConverterParameter="Statistics"/>
          </TextBlock.IsVisible>
        </TextBlock>

        <!-- 설정 타이틀 -->
        <TextBlock Text="임대주택 설정" FontSize="18" Foreground="White"
                   Margin="12,0,0,0" VerticalAlignment="Center"
                   DockPanel.Dock="Left">
          <TextBlock.IsVisible>
            <Binding Path="CurrentPage" Converter="{StaticResource PageTypeConverter}" ConverterParameter="Settings"/>
          </TextBlock.IsVisible>
        </TextBlock>

        <!-- 전체화면 버튼 (우상단) -->
        <Button Command="{Binding ToggleFullScreenCommand}"
                Width="40" Height="36"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                DockPanel.Dock="Right"
                ToolTip.Tip="전체화면">
          <Path Data="M5,5 L5,10 M5,5 L10,5 M19,5 L19,10 M19,5 L14,5 M5,19 L5,14 M5,19 L10,19 M19,19 L19,14 M19,19 L14,19"
                Stroke="White" StrokeThickness="2" StrokeLineCap="Round"/>
        </Button>
      </DockPanel>
    </Border>

    <!-- 본문 -->
    <Grid Grid.Row="1">
      <!-- 대시보드 페이지 -->
      <ScrollViewer>
        <ScrollViewer.IsVisible>
          <Binding Path="CurrentPage" Converter="{StaticResource PageTypeConverter}" ConverterParameter="Dashboard"/>
        </ScrollViewer.IsVisible>
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:UnitGroupViewModel">
              <StackPanel Margin="0,8">
                <!-- 그룹 이름 (예: "101동") -->
                <TextBlock Text="{Binding GroupName}" FontSize="20" FontWeight="Bold" Margin="16,8,0,8"/>
                
                <!-- 그룹 내 타일들 (AutoUniformGrid로 가로 공간을 채움) -->
                <ItemsControl ItemsSource="{Binding Units}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <!-- AutoUniformGrid: MinItemWidth를 기준으로 열 개수를 자동 계산하여 타일이 가로 공간을 채우도록 함 -->
                      <controls:AutoUniformGrid MinItemWidth="240" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:UnitTileViewModel">
                      <Border CornerRadius="8" Margin="8" Padding="12" Background="{Binding BackgroundBrush}" BoxShadow="0 4 16 0 #33000000">
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                          </Grid.RowDefinitions>

                          <!-- 세대 이름 -->
                          <TextBlock Text="{Binding UnitName}" FontWeight="Bold" FontSize="16"
                                     Foreground="{Binding ForegroundBrush}"/>

                          <!-- 메시지 -->
                          <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,6,0,0"
                                     Text="{Binding Message}"
                                     Foreground="{Binding ForegroundBrush}"/>

                          <!-- 지표 뱃지 -->
                          <Border Grid.Row="2" HorizontalAlignment="Right" Padding="8,2" CornerRadius="12"
                                  Background="#40000000"
                                  IsVisible="{Binding MetricText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding MetricText}" Foreground="White"/>
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- 그룹간 구분선 -->
                <Border Height="1" Background="#30000000" Margin="16,16,16,8"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- 세대관리 페이지 -->
      <ContentControl Content="{Binding}">
        <ContentControl.IsVisible>
          <Binding Path="CurrentPage" Converter="{StaticResource PageTypeConverter}" ConverterParameter="UnitManagement"/>
        </ContentControl.IsVisible>
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:MainViewModel">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <!-- 검색 및 필터 영역 -->
              <Border Grid.Row="0" Background="{DynamicResource ThemeControlMidBrush}" Padding="16,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <!-- 검색바 -->
                  <TextBox Grid.Column="0" Watermark="세대 검색 (예: 101동 101호)" Margin="0,0,12,0"/>

                  <!-- 필터 버튼 -->
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="전체" Padding="12,6"/>
                    <Button Content="정상" Padding="12,6"/>
                    <Button Content="주의" Padding="12,6"/>
                    <Button Content="긴급" Padding="12,6"/>
                    <Button Content="공실" Padding="12,6"/>
                    <Button Content="수리 중" Padding="12,6"/>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- 세대 목록 -->
              <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Groups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:UnitGroupViewModel">
                      <StackPanel Margin="0,8">
                        <!-- 그룹 이름 (예: "101동") -->
                        <TextBlock Text="{Binding GroupName}" FontSize="20" FontWeight="Bold" Margin="16,8,0,8"/>

                        <!-- 그룹 내 세대 목록 -->
                        <ItemsControl ItemsSource="{Binding Units}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:UnitTileViewModel">
                              <Border CornerRadius="4" Margin="8" Padding="12" Background="{DynamicResource ThemeControlMidBrush}"
                                      BorderBrush="{Binding BackgroundBrush}" BorderThickness="0,0,0,4">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                  </Grid.ColumnDefinitions>

                                  <!-- 세대명 -->
                                  <TextBlock Grid.Column="0" Text="{Binding UnitName}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>

                                  <!-- 메시지/상태 -->
                                  <TextBlock Grid.Column="1" Text="{Binding Message}" VerticalAlignment="Center" Margin="12,0"/>

                                  <!-- 지표 -->
                                  <TextBlock Grid.Column="2" Text="{Binding MetricText}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                  <!-- 액션 버튼 -->
                                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                    <Button Content="상세" Padding="8,4"
                                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ShowUnitDetailCommand}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="수정" Padding="8,4"
                                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ShowUnitEditCommand}"
                                            CommandParameter="{Binding}"/>
                                  </StackPanel>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 그룹간 구분선 -->
                        <Border Height="1" Background="#30000000" Margin="16,16,16,8"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>

      <!-- 임대료/미납 페이지 -->
      <Grid>
        <Grid.IsVisible>
          <Binding Path="CurrentPage" Converter="{StaticResource PageTypeConverter}" ConverterParameter="RentPayment"/>
        </Grid.IsVisible>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 필터 영역 -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeControlMidBrush}" Padding="16,12">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="기간:" VerticalAlignment="Center" FontWeight="Bold"/>
            <ComboBox SelectedIndex="0" Width="150">
              <ComboBoxItem Content="이번 달"/>
              <ComboBoxItem Content="지난 달"/>
              <ComboBoxItem Content="최근 3개월"/>
              <ComboBoxItem Content="최근 6개월"/>
              <ComboBoxItem Content="올해"/>
            </ComboBox>
            <TextBlock Text="상태:" VerticalAlignment="Center" FontWeight="Bold" Margin="20,0,0,0"/>
            <Button Content="전체" Padding="12,6"/>
            <Button Content="정상납부" Padding="12,6"/>
            <Button Content="미납" Padding="12,6"/>
            <Button Content="연체" Padding="12,6"/>
          </StackPanel>
        </Border>

        <!-- 임대료 목록 -->
        <ScrollViewer Grid.Row="1">
          <StackPanel Margin="16">
            <!-- 요약 카드 -->
            <Grid Margin="0,0,0,20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Background="#2E7D32" CornerRadius="8" Padding="20" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="총 수입" Foreground="White" FontSize="14" Opacity="0.9"/>
                  <TextBlock Text="₩12,500,000" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Background="#1976D2" CornerRadius="8" Padding="20" Margin="4,0">
                <StackPanel>
                  <TextBlock Text="정상납부" Foreground="White" FontSize="14" Opacity="0.9"/>
                  <TextBlock Text="₩11,800,000" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Background="#F57C00" CornerRadius="8" Padding="20" Margin="4,0">
                <StackPanel>
                  <TextBlock Text="미납" Foreground="White" FontSize="14" Opacity="0.9"/>
                  <TextBlock Text="₩500,000" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>

              <Border Grid.Column="3" Background="#D32F2F" CornerRadius="8" Padding="20" Margin="8,0,0,0">
                <StackPanel>
                  <TextBlock Text="연체" Foreground="White" FontSize="14" Opacity="0.9"/>
                  <TextBlock Text="₩200,000" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
            </Grid>

            <!-- 임대료 상세 목록 -->
            <TextBlock Text="납부 내역" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
            <Border Background="{DynamicResource ThemeControlMidBrush}" CornerRadius="8" Padding="16">
              <StackPanel>
                <TextBlock Text="개발 예정: 임대료 납부 내역 테이블" FontSize="16" HorizontalAlignment="Center" Margin="0,40"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- 공과금 납입 관리 페이지 -->
      <Grid>
        <Grid.IsVisible>
          <Binding Path="CurrentPage" Converter="{StaticResource PageTypeConverter}" ConverterParameter="UtilityBills"/>
        </Grid.IsVisible>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 필터 영역 -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeControlMidBrush}" Padding="16,12">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="기간:" VerticalAlignment="Center" FontWeight="Bold"/>
            <ComboBox SelectedIndex="0" Width="150">
              <ComboBoxItem Content="이번 달"/>
              <ComboBoxItem Content="지난 달"/>
              <ComboBoxItem Content="최근 3개월"/>
              <ComboBoxItem Content="최근 6개월"/>
              <ComboBoxItem Content="올해"/>
            </ComboBox>
            <TextBlock Text="공과금 유형:" VerticalAlignment="Center" FontWeight="Bold" Margin="20,0,0,0"/>
            <Button Content="전체" Padding="12,6"/>
            <Button Content="전기" Padding="12,6"/>
            <Button Content="가스" Padding="12,6"/>
            <Button Content="수도" Padding="12,6"/>
            <Button Content="관리비" Padding="12,6"/>
          </StackPanel>
        </Border>

        <!-- 공과금 내용 -->
        <ScrollViewer Grid.Row="1">
          <StackPanel Margin="16">
            <!-- 요약 카드 -->
            <Grid Margin="0,0,0,20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Background="#FF6F00" CornerRadius="8" Padding="20" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="전기" Foreground="White" FontSize="14" Opacity="0.9"/>
                  <TextBlock Text="₩1,250,000" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/>
                  <TextBlock Text="이번 달" Foreground="White" FontSize="12" Opacity="0.8" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Background="#0288D1" CornerRadius="8" Padding="20" Margin="4,0">
                <StackPanel>
                  <TextBlock Text="수도" Foreground="White" FontSize="14" Opacity="0.9"/>
                  <TextBlock Text="₩420,000" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/>
                  <TextBlock Text="이번 달" Foreground="White" FontSize="12" Opacity="0.8" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Background="#E65100" CornerRadius="8" Padding="20" Margin="4,0">
                <StackPanel>
                  <TextBlock Text="가스" Foreground="White" FontSize="14" Opacity="0.9"/>
                  <TextBlock Text="₩680,000" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/>
                  <TextBlock Text="이번 달" Foreground="White" FontSize="12" Opacity="0.8" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>

              <Border Grid.Column="3" Background="#5E35B1" CornerRadius="8" Padding="20" Margin="8,0,0,0">
                <StackPanel>
                  <TextBlock Text="관리비" Foreground="White" FontSize="14" Opacity="0.9"/>
                  <TextBlock Text="₩1,850,000" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/>
                  <TextBlock Text="이번 달" Foreground="White" FontSize="12" Opacity="0.8" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </Grid>

            <!-- 세대별 공과금 목록 -->
            <TextBlock Text="세대별 공과금 내역" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

            <!-- 샘플 데이터 -->
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:UnitGroupViewModel">
                  <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="{Binding GroupName}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>

                    <ItemsControl ItemsSource="{Binding Units}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:UnitTileViewModel">
                          <Border Background="{DynamicResource ThemeControlMidBrush}"
                                  CornerRadius="8" Padding="16" Margin="0,0,0,8">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                              </Grid.ColumnDefinitions>

                              <TextBlock Grid.Column="0" Text="{Binding UnitName}" FontWeight="Bold" VerticalAlignment="Center"/>

                              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Background="#FF6F00" CornerRadius="4" Padding="8,4">
                                  <TextBlock Text="전기" Foreground="White" FontSize="11"/>
                                </Border>
                                <Border Background="#0288D1" CornerRadius="4" Padding="8,4">
                                  <TextBlock Text="수도" Foreground="White" FontSize="11"/>
                                </Border>
                                <Border Background="#E65100" CornerRadius="4" Padding="8,4">
                                  <TextBlock Text="가스" Foreground="White" FontSize="11"/>
                                </Border>
                                <Border Background="#5E35B1" CornerRadius="4" Padding="8,4">
                                  <TextBlock Text="관리비" Foreground="White" FontSize="11"/>
                                </Border>
                              </StackPanel>

                              <TextBlock Grid.Column="2" Text="₩35,000" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                              <TextBlock Grid.Column="3" Text="₩12,000" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                              <TextBlock Grid.Column="4" Text="₩19,000" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                              <TextBlock Grid.Column="5" Text="₩52,000" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- 통계 페이지 -->
      <Grid>
        <Grid.IsVisible>
          <Binding Path="CurrentPage" Converter="{StaticResource PageTypeConverter}" ConverterParameter="Statistics"/>
        </Grid.IsVisible>
        <ScrollViewer>
          <StackPanel Margin="16">
            <TextBlock Text="통계 대시보드" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

            <!-- 통계 카드 그리드 -->
            <Grid Margin="0,0,0,20">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- 입주율 -->
              <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource ThemeControlMidBrush}"
                      CornerRadius="8" Padding="20" Margin="0,0,8,8">
                <StackPanel>
                  <TextBlock Text="입주율" FontSize="18" FontWeight="Bold"/>
                  <TextBlock Text="85.7%" FontSize="36" FontWeight="Bold" Margin="0,12,0,0"/>
                  <TextBlock Text="30 / 35 세대" FontSize="14" Opacity="0.7" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>

              <!-- 평균 임대료 -->
              <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource ThemeControlMidBrush}"
                      CornerRadius="8" Padding="20" Margin="8,0,0,8">
                <StackPanel>
                  <TextBlock Text="평균 임대료" FontSize="18" FontWeight="Bold"/>
                  <TextBlock Text="₩416,667" FontSize="36" FontWeight="Bold" Margin="0,12,0,0"/>
                  <TextBlock Text="월 평균" FontSize="14" Opacity="0.7" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>

              <!-- 미납률 -->
              <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource ThemeControlMidBrush}"
                      CornerRadius="8" Padding="20" Margin="0,8,8,0">
                <StackPanel>
                  <TextBlock Text="미납률" FontSize="18" FontWeight="Bold"/>
                  <TextBlock Text="5.6%" FontSize="36" FontWeight="Bold" Margin="0,12,0,0"/>
                  <TextBlock Text="2 / 35 세대" FontSize="14" Opacity="0.7" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>

              <!-- 평균 체류기간 -->
              <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource ThemeControlMidBrush}"
                      CornerRadius="8" Padding="20" Margin="8,8,0,0">
                <StackPanel>
                  <TextBlock Text="평균 체류기간" FontSize="18" FontWeight="Bold"/>
                  <TextBlock Text="2.3년" FontSize="36" FontWeight="Bold" Margin="0,12,0,0"/>
                  <TextBlock Text="입주자 평균" FontSize="14" Opacity="0.7" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </Grid>

            <!-- 차트 영역 (플레이스홀더) -->
            <TextBlock Text="월별 수입 추이" FontSize="20" FontWeight="Bold" Margin="0,20,0,12"/>
            <Border Background="{DynamicResource ThemeControlMidBrush}" CornerRadius="8" Padding="20" Height="300">
              <TextBlock Text="개발 예정: 차트 영역" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- 설정 페이지 -->
      <Grid>
        <Grid.IsVisible>
          <Binding Path="CurrentPage" Converter="{StaticResource PageTypeConverter}" ConverterParameter="Settings"/>
        </Grid.IsVisible>
        <ScrollViewer>
          <StackPanel Margin="16" MaxWidth="800">
            <TextBlock Text="설정" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

            <!-- 일반 설정 -->
            <TextBlock Text="일반" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
            <Border Background="{DynamicResource ThemeControlMidBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,20">
              <StackPanel Spacing="16">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="다크 모드" FontWeight="Bold"/>
                    <TextBlock Text="어두운 테마 사용" FontSize="12" Opacity="0.7"/>
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>

                <Separator/>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="알림" FontWeight="Bold"/>
                    <TextBlock Text="중요 이벤트 알림 받기" FontSize="12" Opacity="0.7"/>
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="True"/>
                </Grid>

                <Separator/>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="언어" FontWeight="Bold"/>
                    <TextBlock Text="인터페이스 언어 선택" FontSize="12" Opacity="0.7"/>
                  </StackPanel>
                  <ComboBox Grid.Column="1" SelectedIndex="0" VerticalAlignment="Center">
                    <ComboBoxItem Content="한국어"/>
                    <ComboBoxItem Content="English"/>
                  </ComboBox>
                </Grid>
              </StackPanel>
            </Border>

            <!-- 데이터 설정 -->
            <TextBlock Text="데이터" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
            <Border Background="{DynamicResource ThemeControlMidBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,20">
              <StackPanel Spacing="12">
                <Button Content="데이터 내보내기" HorizontalAlignment="Left" Padding="16,8"/>
                <Button Content="데이터 가져오기" HorizontalAlignment="Left" Padding="16,8"/>
                <Button Content="데이터베이스 백업" HorizontalAlignment="Left" Padding="16,8"/>
              </StackPanel>
            </Border>

            <!-- 정보 -->
            <TextBlock Text="정보" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
            <Border Background="{DynamicResource ThemeControlMidBrush}" CornerRadius="8" Padding="20">
              <StackPanel Spacing="8">
                <TextBlock Text="버전: 1.0.0" FontSize="14"/>
                <TextBlock Text="임대주택 관리 콘솔" FontSize="14"/>
                <TextBlock Text="© 2025 All rights reserved" FontSize="12" Opacity="0.7" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- 오버레이 클릭 닫기 -->
      <ToggleButton x:Name="OverlayCloseButton"
                    IsVisible="{Binding IsPaneOpen}"
                    IsChecked="{Binding IsPaneOpen, Mode=TwoWay}"
                    Background="#80000000"
                    BorderThickness="0"
                    Content=""
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Focusable="False">
        <ToggleButton.Template>
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    BorderBrush="{TemplateBinding BorderBrush}">
              <!-- overlay 영역만 렌더링 -->
            </Border>
          </ControlTemplate>
        </ToggleButton.Template>
      </ToggleButton>

      <!-- 슬라이드 메뉴 -->
      <Border IsVisible="{Binding IsPaneOpen}"
              Width="280" Background="#F5F5F5"
              HorizontalAlignment="Left" VerticalAlignment="Stretch"
              BoxShadow="0 8 24 0 #40000000">
        <DockPanel>
          <StackPanel>
            <Button Content="대시보드" Command="{Binding OpenDashboardCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="16,12" Background="Transparent" BorderThickness="0"/>
            <Button Content="세대 관리" Command="{Binding OpenUnitManagementCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="16,12" Background="Transparent" BorderThickness="0"/>
            <Button Content="임대료/미납" Command="{Binding OpenRentPaymentCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="16,12" Background="Transparent" BorderThickness="0"/>
            <Button Content="공과금 납입 관리" Command="{Binding OpenUtilityBillsCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="16,12" Background="Transparent" BorderThickness="0"/>
            <Button Content="통계" Command="{Binding OpenStatisticsCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="16,12" Background="Transparent" BorderThickness="0"/>
            <Button Content="설정" Command="{Binding OpenSettingsCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="16,12" Background="Transparent" BorderThickness="0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- 세대 상세 다이얼로그 -->
      <Border IsVisible="{Binding IsDetailDialogOpen}"
              Background="#80000000"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
        <Border Background="White"
                Width="500"
                CornerRadius="8"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 8 32 0 #60000000">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 헤더 -->
            <TextBlock Grid.Row="0" Text="세대 상세 정보" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

            <!-- 내용 -->
            <ScrollViewer Grid.Row="1" MaxHeight="400">
              <StackPanel Spacing="16" DataContext="{Binding SelectedUnit}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="세대명:" FontWeight="Bold" VerticalAlignment="Center"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding UnitName}" VerticalAlignment="Center" Margin="8,0,0,0"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="입주자명:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,8,0,0"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TenantName}" VerticalAlignment="Center" Margin="8,8,0,0"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="연락처:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,8,0,0"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PhoneNumber}" VerticalAlignment="Center" Margin="8,8,0,0"/>

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="입주일:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,8,0,0"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MoveInDate, StringFormat='{}{0:yyyy-MM-dd}'}" VerticalAlignment="Center" Margin="8,8,0,0"/>

                  <TextBlock Grid.Row="4" Grid.Column="0" Text="월 임대료:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,8,0,0"/>
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding MonthlyRent, StringFormat='₩{0:N0}'}" VerticalAlignment="Center" Margin="8,8,0,0"/>

                  <TextBlock Grid.Row="5" Grid.Column="0" Text="보증금:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,8,0,0"/>
                  <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Deposit, StringFormat='₩{0:N0}'}" VerticalAlignment="Center" Margin="8,8,0,0"/>

                  <TextBlock Grid.Row="6" Grid.Column="0" Text="상태:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,8,0,0"/>
                  <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Message}" VerticalAlignment="Center" Margin="8,8,0,0"/>

                  <TextBlock Grid.Row="7" Grid.Column="0" Text="비고:" FontWeight="Bold" VerticalAlignment="Top" Margin="0,8,0,0"/>
                  <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Notes}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,8,0,0"/>
                </Grid>
              </StackPanel>
            </ScrollViewer>

            <!-- 버튼 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,20,0,0">
              <Button Content="닫기" Padding="16,8" Command="{Binding CloseDetailDialogCommand}"/>
            </StackPanel>
          </Grid>
        </Border>
      </Border>

      <!-- 세대 수정 다이얼로그 -->
      <Border IsVisible="{Binding IsEditDialogOpen}"
              Background="#80000000"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
        <Border Background="White"
                Width="500"
                CornerRadius="8"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 8 32 0 #60000000">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 헤더 -->
            <TextBlock Grid.Row="0" Text="세대 정보 수정" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

            <!-- 내용 -->
            <ScrollViewer Grid.Row="1" MaxHeight="400">
              <StackPanel Spacing="12" DataContext="{Binding SelectedUnit}">
                <TextBlock Text="세대명" FontWeight="Bold"/>
                <TextBox Text="{Binding UnitName}" Watermark="예: 101동 101호"/>

                <TextBlock Text="입주자명" FontWeight="Bold" Margin="0,8,0,0"/>
                <TextBox Text="{Binding TenantName}" Watermark="입주자 이름"/>

                <TextBlock Text="연락처" FontWeight="Bold" Margin="0,8,0,0"/>
                <TextBox Text="{Binding PhoneNumber}" Watermark="010-1234-5678"/>

                <TextBlock Text="입주일" FontWeight="Bold" Margin="0,8,0,0"/>
                <DatePicker SelectedDate="{Binding MoveInDate}"/>

                <TextBlock Text="월 임대료 (원)" FontWeight="Bold" Margin="0,8,0,0"/>
                <TextBox Text="{Binding MonthlyRent}" Watermark="400000"/>

                <TextBlock Text="보증금 (원)" FontWeight="Bold" Margin="0,8,0,0"/>
                <TextBox Text="{Binding Deposit}" Watermark="5000000"/>

                <TextBlock Text="상태" FontWeight="Bold" Margin="0,8,0,0"/>
                <ComboBox SelectedIndex="0">
                  <ComboBoxItem Content="정상"/>
                  <ComboBoxItem Content="주의"/>
                  <ComboBoxItem Content="긴급"/>
                  <ComboBoxItem Content="공실"/>
                  <ComboBoxItem Content="수리 중"/>
                </ComboBox>

                <TextBlock Text="비고" FontWeight="Bold" Margin="0,8,0,0"/>
                <TextBox Text="{Binding Notes}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="80"
                         Watermark="특이사항 입력"/>
              </StackPanel>
            </ScrollViewer>

            <!-- 버튼 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,20,0,0">
              <Button Content="취소" Padding="16,8" Command="{Binding CloseEditDialogCommand}"/>
              <Button Content="저장" Padding="16,8" Command="{Binding SaveUnitEditCommand}"/>
            </StackPanel>
          </Grid>
        </Border>
      </Border>
    </Grid>
  </Grid>
</UserControl>
